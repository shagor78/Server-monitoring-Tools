# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL Runtime Environment Variables (Injected by platform)
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# Monitoring Stack Endpoints
PROMETHEUS_URL="http://prometheus:9090"
ALERTMANAGER_URL="http://alertmanager:9093"
GRAFANA_URL="http://grafana:3000"
LOKI_URL="http://loki:3100"

# Notification Providers (Configured via Secrets / Environment)
SMTP_HOST="smtp.internal.noc"
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# AWS EC2 Integration (Prefer IAM Role in production)
AWS_REGION="ap-southeast-1"
AWS_IAM_ROLE_ARN="arn:aws:iam::123456789012:role/AegisNOCReadOnlyRole"
